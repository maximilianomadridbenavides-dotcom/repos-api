{
  "name": "repos-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "c8 --all --include=*.js --reporter=text --reporter=lcov node --test test/*.test.js",
    "start": "node server.js",
    "test:coverage": "c8 --all --include=*.js --reporter=text --reporter=lcov --check-coverage --lines 90 --statements 90 --functions 90 --branches 80 node --test test/*.test.js"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
